# FlinsMusic — Client Configuration Template
# ============================================================
# This file is a TEMPLATE. Copy it to `.env` for local configuration.
# `.env` is git-ignored and must NEVER be committed to version control.
#
# NOTE: YouTube session cookies must NEVER be placed here.
# All authenticated YouTube operations are managed strictly on the backend.
# ============================================================

# Required for Gemini AI API calls (optional).
GEMINI_API_KEY=your_gemini_api_key_placeholder

# OAuth 2.0 Web Client ID for Google Sign-In (Firebase Authentication).
# Found in Firebase Console -> Authentication -> Sign-in method -> Google.
WEB_CLIENT_ID=your_web_client_id_placeholder.apps.googleusercontent.com

# Backend base URL for music extraction and proxy service.
BACKEND_BASE_URL=https://your-backend-host.example.com
